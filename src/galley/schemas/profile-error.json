  "additionalProperties": false,
  "required": ["error", "outcome", "schema"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "profile"],
      "properties": {
        "code": {"const": "unknown-profile"},
        "message": {"type": "string"},
        "profile": {"type": "string"}
      }
    },
    "outcome": {"const": "invocation-error"},
    "schema": {"const": "galley/profile-error/1"}
  }
}
