{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galley/inbox-check/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "galley", "outcome", "refusal", "workspace", "configuration", "coverage", "candidates",
    "evidence_problems"
  ],
  "oneOf": [
    {
      "properties": { "outcome": { "const": "completed" }, "refusal": { "type": "null" } }
    },
    {
      "properties": { "outcome": { "const": "refused" }, "refusal": { "$ref": "#/$defs/refusal" } }
    }
  ],
  "properties": {
    "galley": { "$ref": "#/$defs/galley" },
    "outcome": { "enum": ["completed", "refused"] },
    "refusal": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/refusal" }]
    },
    "workspace": { "$ref": "#/$defs/workspace" },
    "configuration": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/configuration" }]
    },
    "coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverage" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "evidence_problems": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceProblem" }
    }
  },
  "$defs": {
    "galley": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "command", "run_id", "started_at", "finished_at", "duration_ms",
        "document_schema"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "command": { "const": "inbox check" },
        "run_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "finished_at": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "document_schema": { "const": "galley/inbox-check/1" }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "authority", "stage", "summary", "fact"],
      "properties": {
        "boundary": { "type": "string", "minLength": 1 },
        "authority": { "const": "inbox check" },
        "stage": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "fact": { "type": "object" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "configuration_path"],
      "properties": {
        "source": { "enum": ["option", "environment", "default"] },
        "path": { "type": "string", "minLength": 1 },
        "configuration_path": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version"],
      "properties": {
        "schema": { "const": "galley/workspace-config/1" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "resolved_path", "recursive", "status", "supported_count", "ignored_count",
        "error"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "resolved_path": { "type": "string", "minLength": 1 },
        "recursive": { "type": "boolean" },
        "status": { "enum": ["checked", "unavailable"] },
        "supported_count": { "type": "integer", "minimum": 0 },
        "ignored_count": { "type": "integer", "minimum": 0 },
        "error": { "type": ["string", "null"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_inbox", "inboxes", "display_path", "resolved_path", "source_kind", "byte_size",
        "modified_at", "sha256", "state", "latest_attempt"
      ],
      "properties": {
        "primary_inbox": { "type": "string", "minLength": 1 },
        "inboxes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "display_path": { "type": "string", "minLength": 1 },
        "resolved_path": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 0 },
        "modified_at": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "state": { "enum": ["new", "changed", "already-ready"] },
        "latest_attempt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attempt" }]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "stage", "summary", "finished_at"],
      "properties": {
        "boundary": { "type": "string", "minLength": 1 },
        "stage": { "type": "string" },
        "summary": { "type": "string" },
        "finished_at": { "type": "string" }
      }
    },
    "evidenceProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "evidence_path", "artifact_path"],
      "properties": {
        "problem": {
          "enum": [
            "unreadable-report",
            "incomplete-report",
            "artifact-missing",
            "artifact-unreadable",
            "artifact-mismatched"
          ]
        },
        "evidence_path": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": ["string", "null"] }
      }
    }
  }
}
