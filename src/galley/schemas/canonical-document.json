{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galley/canonical-document/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "author", "source_url", "warnings", "pandoc"],
  "properties": {
    "schema": { "const": "galley/canonical-document/1" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "pandoc": { "$ref": "#/$defs/pandoc" }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "event", "detail", "recomputable"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "recomputable": { "const": false }
      }
    },
    "pandoc": {
      "type": "object",
      "required": ["pandoc-api-version", "meta", "blocks"],
      "properties": {
        "pandoc-api-version": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "meta": { "type": "object" },
        "blocks": { "type": "array" }
      }
    }
  }
}
